// Frontend deploy pipeline: build React app, upload to S3, invalidate CloudFront.
// Bucket, distribution, API URLs, credentials, and branch are supplied by Jenkins parameters.

pipeline {
    agent {
        label 'terraform'
    }

    parameters {
        string(name: 'GIT_URL', defaultValue: 'https://github.com/atulyw/cdec-alpha-app.git', description: 'Repository URL to checkout.')
        string(name: 'GIT_BRANCH', defaultValue: 'main', description: 'Git branch to deploy.')
        string(name: 'AWS_CREDENTIALS_ID', defaultValue: 'aws-frontend-terraform', description: 'Jenkins AWS credentials ID.')
        string(name: 'AWS_REGION', defaultValue: 'eu-west-1', description: 'AWS region for S3 operations.')

        string(name: 'S3_BUCKET', defaultValue: 'cdec-alpha-dev-frontend', description: 'S3 bucket name for the frontend.')
        string(name: 'CLOUDFRONT_DISTRIBUTION_ID', defaultValue: 'E2T929LQJJ7AIS', description: 'CloudFront distribution ID. Leave blank to skip invalidation.')

        string(name: 'VITE_AUTH_API', defaultValue: 'https://api.thecloudnine.in/api/auth', description: 'Auth API URL baked into the build.')
        string(name: 'VITE_COURSE_API', defaultValue: 'https://api.thecloudnine.in/api/courses', description: 'Course API URL baked into the build.')
        string(name: 'VITE_ENROLL_API', defaultValue: 'https://api.thecloudnine.in/api/enroll', description: 'Enrollment API URL baked into the build.')
    }

    environment {
        APP_DIR = 'application/frontend'
    }

    stages {
        stage('Checkout') {
            steps {
                git url: params.GIT_URL, branch: params.GIT_BRANCH
            }
        }

        stage('Install dependencies') {
            steps {
                dir(env.APP_DIR) {
                    sh 'npm ci'
                }
            }
        }

        stage('Build') {
            steps {
                dir(env.APP_DIR) {
                    sh """
                        export VITE_AUTH_API=${params.VITE_AUTH_API}
                        export VITE_COURSE_API=${params.VITE_COURSE_API}
                        export VITE_ENROLL_API=${params.VITE_ENROLL_API}
                        npm run build
                    """
                }
            }
        }

        stage('Deploy to S3') {
            steps {
                withCredentials([[
                    $class: 'AmazonWebServicesCredentialsBinding',
                    credentialsId: params.AWS_CREDENTIALS_ID,
                    accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                    secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                ]]) {
                    dir(env.APP_DIR) {
                        sh """
                            echo "Uploading to s3://${params.S3_BUCKET}/"
                            aws s3 sync dist/ s3://${params.S3_BUCKET}/ --delete --region ${params.AWS_REGION}
                        """
                    }
                }
            }
        }

        stage('Invalidate CloudFront') {
            when {
                expression { params.CLOUDFRONT_DISTRIBUTION_ID?.trim() }
            }
            steps {
                withCredentials([[
                    $class: 'AmazonWebServicesCredentialsBinding',
                    credentialsId: params.AWS_CREDENTIALS_ID,
                    accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                    secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                ]]) {
                    sh """
                        echo "Invalidating CloudFront distribution ${params.CLOUDFRONT_DISTRIBUTION_ID}"
                        aws cloudfront create-invalidation \
                            --distribution-id ${params.CLOUDFRONT_DISTRIBUTION_ID} \
                            --paths "/*"
                    """
                }
            }
        }
    }

    post {
        success {
            echo 'Frontend deployed successfully.'
        }
        failure {
            echo 'Frontend deployment failed. Check the stage logs above.'
        }
    }
}
