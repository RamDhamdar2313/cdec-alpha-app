// Auth service deploy pipeline: build Docker image, push to ECR, roll out to EKS.
// Cluster, registry, namespace, and image tag are supplied by Jenkins parameters.

pipeline {
    agent {
        label 'terraform'
    }

    parameters {
        string(name: 'GIT_URL', defaultValue: 'https://github.com/atulyw/cdec-alpha-app.git', description: 'Repository URL to checkout.')
        string(name: 'GIT_BRANCH', defaultValue: 'main', description: 'Git branch to deploy.')
        string(name: 'AWS_CREDENTIALS_ID', defaultValue: 'aws-frontend-terraform', description: 'Jenkins AWS credentials ID.')

        string(name: 'AWS_ACCOUNT_ID', defaultValue: '933516006319', description: 'AWS account ID that owns the ECR repositories.')
        string(name: 'ECR_REGION', defaultValue: 'eu-west-1', description: 'AWS region for ECR.')
        string(name: 'ECR_REPOSITORY', defaultValue: 'backend/auth-service', description: 'ECR repository name/path.')
        string(name: 'IMAGE_TAG', defaultValue: 'latest', description: 'Docker image tag to build and deploy.')

        string(name: 'EKS_CLUSTER', defaultValue: 'cdec-eks-dev', description: 'Target EKS cluster name.')
        string(name: 'EKS_REGION', defaultValue: 'eu-west-1', description: 'Target EKS cluster region.')
        string(name: 'K8S_NAMESPACE', defaultValue: 'default', description: 'Kubernetes namespace to deploy into.')
        string(name: 'MONGO_DATABASE', defaultValue: 'cb_auth', description: 'MongoDB database name.')
    }

    environment {
        MONGO_OPTIONS = 'retryWrites=true&w=majority&appName=cdec-dev'
    }

    stages {
        stage('Checkout') {
            steps {
                git url: params.GIT_URL, branch: params.GIT_BRANCH
            }
        }

        stage('Build Docker image') {
            agent {
                label 'master'
            }
            steps {
                dir('application/backend/auth-service') {
                    sh """
                        echo "===== DEBUG ====="
                        whoami
                        id
                        hostname
                        pwd
                        groups
                        which docker
                        docker --version
                        docker ps
                        docker build -t ${params.AWS_ACCOUNT_ID}.dkr.ecr.${params.ECR_REGION}.amazonaws.com/${params.ECR_REPOSITORY}:${params.IMAGE_TAG} .
                    """
                }
            }
        }

        stage('Push to ECR') {
            agent {
                label 'master'
            }
            steps {
                withCredentials([[
                    $class: 'AmazonWebServicesCredentialsBinding',
                    credentialsId: params.AWS_CREDENTIALS_ID,
                    accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                    secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                ]]) {
                    sh """
                        aws ecr get-login-password --region ${params.ECR_REGION} | \
                            docker login --username AWS --password-stdin ${params.AWS_ACCOUNT_ID}.dkr.ecr.${params.ECR_REGION}.amazonaws.com
                        docker push ${params.AWS_ACCOUNT_ID}.dkr.ecr.${params.ECR_REGION}.amazonaws.com/${params.ECR_REPOSITORY}:${params.IMAGE_TAG}
                    """
                }
            }
        }

        stage('Deploy to EKS') {
            steps {
                withCredentials([[
                    $class: 'AmazonWebServicesCredentialsBinding',
                    credentialsId: params.AWS_CREDENTIALS_ID,
                    accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                    secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                ]]) {
                    withCredentials([
                        string(credentialsId: 'mongo-uri-auth-service', variable: 'BASE_MONGO_URI'),
                        string(credentialsId: 'jwt-secret-auth-service', variable: 'JWT_SECRET')
                    ]) {
                        dir('application/backend/auth-service') {
                            script {
                                sh """
                                    aws eks update-kubeconfig --region ${params.EKS_REGION} --name ${params.EKS_CLUSTER}
                                    kubectl get namespace ${params.K8S_NAMESPACE} || kubectl create namespace ${params.K8S_NAMESPACE}

                                    kubectl apply -f k8s/deployment.yml -n ${params.K8S_NAMESPACE}
                                    kubectl set image deployment/auth-service auth-service=${params.AWS_ACCOUNT_ID}.dkr.ecr.${params.ECR_REGION}.amazonaws.com/${params.ECR_REPOSITORY}:${params.IMAGE_TAG} -n ${params.K8S_NAMESPACE}
                                    set +x
                                    MONGO_URI="\$BASE_MONGO_URI/\$MONGO_DATABASE?\$MONGO_OPTIONS"
                                    kubectl set env deployment/auth-service \
                                        MONGO_URI="\$MONGO_URI" \
                                        JWT_SECRET="\$JWT_SECRET" \
                                        -n ${params.K8S_NAMESPACE}
                                    kubectl rollout status deployment/auth-service -n ${params.K8S_NAMESPACE} --timeout=300s
                                """
                            }
                        }
                    }
                }
            }
        }
    }

    post {
        success {
            echo 'auth-service deployed successfully.'
        }
        failure {
            echo 'auth-service deployment failed. Check the stage logs above.'
        }
    }
}
